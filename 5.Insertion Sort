#include <stdio.h>

// ইনসারশন সর্ট ফাংশন - অ্যারেকে ছোট থেকে বড় ক্রমে সাজায়
void insertionSort(int arr[], int n) {
    // অ্যারের দ্বিতীয় উপাদান থেকে শুরু করা হচ্ছে (প্রথমটি ইতিমধ্যে সর্টেড ধরা হয়)
    for (int i = 1; i < n; i++) {
        int temp = arr[i];  // বর্তমান উপাদানটি temp এ সংরক্ষণ করা হলো, যেটা সঠিক জায়গায় বসাতে হবে
        int j = i - 1;      // temp এর আগের উপাদানের ইনডেক্স

        // arr[0..i-1] এর মধ্যে যেসব উপাদান temp থেকে বড়, সেগুলোকে
        // এক ঘর ডানে সরিয়ে temp এর জন্য জায়গা খালি করা হচ্ছে
        while (j >= 0 && arr[j] > temp) {
            arr[j + 1] = arr[j];  // বড় উপাদানটিকে এক ঘর ডানে সরানো হলো
            j--;                  // পেছনের দিকে যাওয়া হচ্ছে
        }

        // সঠিক জায়গায় temp বসানো হলো
        arr[j + 1] = temp;
    }
}

// অ্যারের উপাদানগুলো প্রিন্ট করার ফাংশন
void printArray(int arr[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
}

int main() {
    int arr[] = {12, 11, 13, 5, 6};
    int n = sizeof(arr) / sizeof(arr[0]);  // অ্যারের মোট উপাদান সংখ্যা বের করা হচ্ছে

    printf("সর্ট করার আগে: ");
    printArray(arr, n);

    insertionSort(arr, n);  // ইনসারশন সর্ট ফাংশন কল করা হলো

    printf("সর্ট করার পরে: ");
    printArray(arr, n);

    return 0;
}
